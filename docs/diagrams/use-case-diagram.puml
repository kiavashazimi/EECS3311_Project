@startuml
title Project-Aware Research Consultant — Use Case Diagram

left to right direction
skinparam linetype ortho

actor "Researcher" as R

rectangle "Project-Aware Research Consultant" {
  usecase "UC01\nSet Up Project Profile" as UC01
  usecase "UC02\nImport Project Context" as UC02
  usecase "UC03\nDiscover New Papers" as UC03
  usecase "UC04\nAnalyze and Classify a Paper" as UC04
  usecase "UC05\nCompare Paper to Own Project" as UC05
  usecase "UC06\nCheck Result Comparability" as UC06
  usecase "UC07\nSearch for Prior Work" as UC07
  usecase "UC08\nInspect Paper Repository" as UC08
  usecase "UC09\nReview Project Changes" as UC09
  usecase "UC10\nAsk a Project-Aware Question" as UC10
  usecase "UC11\nGenerate Digest" as UC11
