# .env.example - contains no real credentials.
# Copy to .env and fill in your own key:  cp .env.example .env
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
LLM_MODEL=claude-sonnet-5-5
LLM_BASE_URL=https://api.anthropic.com/v1/messages

# Where the application stores project memory on disk.
# Left unset on purpose: the default is ~/.research-consultant, which is
# absolute, so the GUI and the CLI always agree on one file. Only override it
# with an ABSOLUTE path - a relative one such as ./data resolves against the
# working directory, which differs between `mvn javafx:run`, `mvn exec:java`
# and a packaged jar, giving you two memory files that silently disagree.
# RC_DATA_DIR=/home/you/somewhere/absolute
